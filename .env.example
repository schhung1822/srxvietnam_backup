# Copy this file to `.env` or `.env.local` before running the app.
# On deployment, add the same variables in your hosting platform's environment settings.

NEXT_PUBLIC_SITE_URL=https://srxvietnam.vn
# Domain public dùng để dựng link gửi ra ngoài (redirect Google, link đặt lại mật khẩu, link affiliate).
# Chỉ cần set khi reverse proxy không truyền Host/X-Forwarded-Host; mặc định lấy theo NEXT_PUBLIC_SITE_URL.
PUBLIC_SITE_ORIGIN=

# Use either DATABASE_URL/MYSQL_URL/DB_URL or the individual DB_* variables below.
DATABASE_URL=
MYSQL_URL=
DB_URL=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

NEXT_PUBLIC_SEPAY_BANK_NAME=
NEXT_PUBLIC_SEPAY_BANK_CODE=ACB
NEXT_PUBLIC_SEPAY_ACCOUNT_NAME=
NEXT_PUBLIC_SEPAY_ACCOUNT_NUMBER=93956886
NEXT_PUBLIC_SEPAY_QR_IMAGE_URL_TEMPLATE=https://qr.sepay.vn/img?acc=93956886&bank=ACB&amount={{amount}}&des={{orderNumber}}
NEXT_PUBLIC_SEPAY_TRANSFER_PREFIX=SRX
SEPAY_WEBHOOK_EXPECTED_ACCOUNT_NUMBER=93956886

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Authorized redirect URI phải khớp: https://<domain>/api/auth/google/callback
# và http://localhost:3000/api/auth/google/callback khi chạy local.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tùy chọn: chỉ set khi muốn ép redirect URI cố định thay vì lấy theo domain đang chạy.
GOOGLE_REDIRECT_URI=

LARK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SRX Viet Nam

SRX_LEAD_FORMS_WEB_API_URL=https://crm.srx.vn/api/srx/lead-forms-web
SRX_LEAD_FORMS_WEB_API_TOKEN=
SRX_AFFILIATE_APPLICATIONS_WEB_API_URL=https://crm.srx.vn/api/srx/affiliate-applications-web
SRX_AFFILIATE_APPLICATIONS_WEB_API_TOKEN=
SRX_ORDERS_WEB_API_URL=https://crm.srx.vn/api/srx/orders_web
SRX_ORDERS_WEB_API_TOKEN=
SRX_NEW_ORDER_WEBHOOK_URL=https://nextg.nextgency.vn/webhook/srx/new-order
